[Unit]
Description=Spark LLM Router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/workspace/Spark_01
Environment=SPARK_ROUTER_CONFIG=/workspace/Spark_01/config/models.yaml
ExecStart=/workspace/Spark_01/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
